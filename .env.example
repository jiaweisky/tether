# Secrets only. Copy to .env and fill in. .env is git-ignored.
# The bridge reads every secret from the environment; YAML holds no secrets.

# go-agent-sdk HTTP/SSE bearer token
AGENTSERVE_TOKEN=

# WeCom smart robot (long connection)
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# Feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# QQ botpy
QQ_BOT_APPID=
QQ_BOT_SECRET=
